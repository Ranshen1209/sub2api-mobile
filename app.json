{
  "expo": {
    "name": "Sakrylle Admin",
    "slug": "sakrylle-admin",
    "owner": "ckken",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icons/ios/AppIcon.appiconset/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f1fa"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./icons/ios/AppIcon.appiconset/icon-1024.png",
      "bundleIdentifier": "com.sakrylle.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./icons/android/playstore-icon.png",
      "package": "com.sakrylle.admin",
      "adaptiveIcon": {
        "backgroundColor": "#f5f1fa",
        "foregroundImage": "./icons/android/playstore-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./icons/ios/AppIcon.appiconset/icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-bottom-tabs"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acaedd05-5a2a-4843-a648-e025c08ce7b3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/acaedd05-5a2a-4843-a648-e025c08ce7b3"
    },
    "scheme": "sakrylle"
  }
}
